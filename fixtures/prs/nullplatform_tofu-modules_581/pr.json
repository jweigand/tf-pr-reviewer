    "starred_url": "https://api.github.com/users/agustincelentano/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/agustincelentano/subscriptions",
    "organizations_url": "https://api.github.com/users/agustincelentano/orgs",
    "repos_url": "https://api.github.com/users/agustincelentano/repos",
    "events_url": "https://api.github.com/users/agustincelentano/events{/privacy}",
    "received_events_url": "https://api.github.com/users/agustincelentano/received_events",
