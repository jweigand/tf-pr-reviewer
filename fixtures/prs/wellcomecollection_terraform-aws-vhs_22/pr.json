  "title": "Let callers turn on DynamoDB deletion protection and PITR",
  "user": {
    "login": "kenoir",
    "id": 953792,
    "node_id": "MDQ6VXNlcjk1Mzc5Mg==",
    "avatar_url": "https://avatars.githubusercontent.com/u/953792?v=4",
    "gravatar_id": "",
