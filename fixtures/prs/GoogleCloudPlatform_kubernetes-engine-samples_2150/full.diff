+                LeRobotReadTask(
+                    segments=entry["segments"],
+                    metas_ref=metas_ref,
+                    rows_per_batch=rows_per_batch,
+                    per_task_row_limit=per_task_row_limit,
+                    action_chunk_size=self._action_chunk_size,
+                )
+                for entry in task_plan
