  "title": "feat(eks): pin the cluster addon versions with addon_versions",
  "user": {
    "login": "agustincelentano",
    "id": 12614595,
    "node_id": "MDQ6VXNlcjEyNjE0NTk1",
    "avatar_url": "https://avatars.githubusercontent.com/u/12614595?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/agustincelentano",
    "html_url": "https://github.com/agustincelentano",
