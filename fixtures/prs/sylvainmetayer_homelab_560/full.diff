diff --git a/ansible/roles/flip_planning/defaults/main.yml b/ansible/roles/flip_planning/defaults/main.yml
index 9a84ab7b..1520ffd3 100644
--- a/ansible/roles/flip_planning/defaults/main.yml
+++ b/ansible/roles/flip_planning/defaults/main.yml
@@ -32,6 +32,39 @@ flip_planning_admin_password: ""
 # Sensitive: must be set in secrets.sops.yaml
 flip_planning_session_encryption_key: ""
 
+# Mentions légales, served publicly on /mentions-legales. Those of the
+# ORGANISER (the employer of the people being scheduled and the data
+# controller), not of the hoster. Left empty, the page announces itself as
+# incomplete. Names and addresses of real people: kept out of this public repo.
+# Sensitive: must be set in secrets.sops.yaml
+flip_planning_legal_editeur: ""
+# Sensitive: must be set in secrets.sops.yaml
+flip_planning_legal_directeur_publication: ""
+# Sensitive: must be set in secrets.sops.yaml
+flip_planning_legal_hebergeur: ""
+# Sensitive: must be set in secrets.sops.yaml
+flip_planning_legal_contact: ""
+# Data controller (RGPD), when it differs from the LCEN publisher above.
+# Sensitive: must be set in secrets.sops.yaml
+flip_planning_legal_responsable_traitement: ""
+# Sensitive: must be set in secrets.sops.yaml
+flip_planning_legal_base_legale: ""
+# DISPLAYED to users and enforced by nobody: the purge is a yearly manual
+# operation (docs/exploitation.md in the app repo). Only announce what is kept.
+# Sensitive: must be set in secrets.sops.yaml
+flip_planning_legal_conservation: ""
+
+# Cloudflare Web Analytics beacon token. Empty = audience measurement off.
+# Set ⇒ a transfer outside the EU that the mentions légales must declare.
+# A public identifier by construction (it ships in every page), so it lives in
+# plain text in host_vars/docker/variables.yaml rather than in sops.
+flip_planning_cloudflare_web_analytics_token: ""
+
+# Repairs the Flyway schema history at startup. Flip to true TEMPORARILY when a
+# migration interrupted halfway blocks every later one, then back to false: it
+# also realigns checksums, which would hide an edited migration.
+flip_planning_flyway_repair_at_start: false
+
 # Reverse proxies the login lockout may believe when it reads X-Forwarded-For.
 #
 # Behind Pangolin the app never sees the client directly: Traefik writes the real
diff --git a/ansible/roles/flip_planning/templates/env.j2 b/ansible/roles/flip_planning/templates/env.j2
index 808b93b6..8c826d84 100644
--- a/ansible/roles/flip_planning/templates/env.j2
+++ b/ansible/roles/flip_planning/templates/env.j2
@@ -1,39 +1,83 @@
-# Environment for the Flip Planning app container
+# Environment for the Flip Planning app container.
+# Reference: .env.prod.example and README.md § Configuration in the app repo
+# (github.com/sylvainmetayer/flip-planning). Defaults are written out on purpose,
+# so this file lists everything the deployment can tune.
 DB_URL=jdbc:postgresql://postgres:5432/{{ flip_planning_db_name }}
 DB_USER={{ flip_planning_db_user }}
 DB_PASSWORD={{ flip_planning_db_password }}
 HTTP_PORT=8080
 TZ=Europe/Paris
+# Repair the Flyway history at startup — temporary, see defaults/main.yml.
+FLYWAY_REPAIR_AT_START={{ flip_planning_flyway_repair_at_start | lower }}
 
+# Error tracking (Bugsink, Sentry-compatible). Audience measurement is Cloudflare
+# Web Analytics; empty token = off.
 SENTRY_DSN=https://e80c2fb7991244f293e4319b7e3d74ba@sylvainmetayer.bugsink.com/1
 SENTRY_ENVIRONMENT=production
-POSTHOG_API_KEY=phc_B9Zo9ZGVHohsBjMZErEzemPLmQbh3iCbEVZrwqN72NLM
-POSTHOG_HOST=https://eu.i.posthog.com
+CLOUDFLARE_WEB_ANALYTICS_TOKEN={{ flip_planning_cloudflare_web_analytics_token }}
 
+# MCP server. The key header is the application default, which is also what the
+# MCP client configuration sends. X-Pangolin=true is set on the request by the
+# Pangolin resource (website_flip_planning.tf): requiring it here refuses a
+# request that reached the origin without going through the proxy, key or not.
 PLANNING_MCP_API_KEY={{ flip_planning_mcp_api_key }}
 PLANNING_MCP_API_KEY_HEADER=X-Api-Key
+PLANNING_MCP_REQUIRED_HEADERS=X-Pangolin=true
 PLANNING_MCP_PANGOLIN_ACCESS_TOKEN_ID={{ flip_planning_mcp_pangolin_access_token_id }}
 PLANNING_MCP_PANGOLIN_ACCESS_TOKEN={{ flip_planning_mcp_pangolin_access_token }}
 
 ADMIN_PASSWORD={{ flip_planning_admin_password }}
+QUARKUS_HTTP_AUTH_SESSION_ENCRYPTION_KEY={{ flip_planning_session_encryption_key }}
+
+# Behind Pangolin (Traefik terminates TLS, newt tunnels to the origin):
+# PROXY_ADDRESS_FORWARDING keeps the login redirect on https and the session
+# cookie Secure.
+PROXY_ADDRESS_FORWARDING=true
 # Peer address the app sees for a request coming through Pangolin: the newt
 # container on the shared bridge. Declared as the network's subnet, since the
 # container address itself is reassigned on restart. Without it, the login
 # lockout counts every visitor on one shared counter.
 CONNEXION_PROXYS_FIABLES={{ flip_planning_trusted_proxies }}
-QUARKUS_HTTP_AUTH_SESSION_ENCRYPTION_KEY={{ flip_planning_session_encryption_key }}
 
+# Mail: Mailpit is a sink that delivers nothing (web UI on /mail). The espace
+# animateur access codes therefore never leave the host — a real SMTP relay is
+# what it would take to open it (MAIL_USERNAME / MAIL_PASSWORD /
+# MAIL_START_TLS=REQUIRED on port 587).
 MAIL_MOCK=false
 MAIL_HOST=mailpit
 MAIL_PORT=1025
+MAIL_USERNAME=
+MAIL_PASSWORD=
+MAIL_START_TLS=DISABLED
 MAIL_FROM=flip-planning@localhost
 MAIL_ADMIN=admin@localhost
 
+# Night jobs: reminders, acknowledgement chasers, stale exchange alerts. The
+# cron is hourly on purpose (each edition sets its own hour on the Paramètres
+# screen and must be armed there — nothing leaves otherwise). JOURNAL_RETENTION
+# is how long the action history is kept before the night purge.
+NOTIFICATIONS_CRON=0 5 * * * ?
+NOTIFICATIONS_TIMEZONE=Europe/Paris
+JOURNAL_RETENTION=P90D
+
 PUBLIC_URL=https://{{ flip_planning_domain }}
 
+# Mentions légales, /mentions-legales. Values live in secrets.sops.yaml.
+LEGAL_EDITEUR={{ flip_planning_legal_editeur }}
+LEGAL_DIRECTEUR_PUBLICATION={{ flip_planning_legal_directeur_publication }}
+LEGAL_HEBERGEUR={{ flip_planning_legal_hebergeur }}
+LEGAL_CONTACT={{ flip_planning_legal_contact }}
+LEGAL_RESPONSABLE_TRAITEMENT={{ flip_planning_legal_responsable_traitement }}
+LEGAL_BASE_LEGALE={{ flip_planning_legal_base_legale }}
+LEGAL_CONSERVATION={{ flip_planning_legal_conservation }}
+
+# Branding. BRANDING_ACCENT_COLOR recolours the application's own stylesheets
+# (not the compiled Angular Material palette); the PDF accent red is reused.
+# BRANDING_SUPPORT_EMAIL is left at the application default.
 BRANDING_PRODUCT_NAME=Flip Planning
 BRANDING_ORGANISATION=Festival Flip — Parthenay
 BRANDING_LOGO_URL=/assets/flip.png
+BRANDING_ACCENT_COLOR=#c81d25
 BRANDING_PDF_LOGO=/assets/flip-logo.png
 BRANDING_PDF_STRIP=/assets/flip-strip.png
 BRANDING_PDF_HEADLINE=#2b2118
