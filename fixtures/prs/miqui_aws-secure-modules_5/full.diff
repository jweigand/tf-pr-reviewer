diff --git a/.github/workflows/validate.yml b/.github/workflows/validate.yml
index ff3b49c..01b00fd 100644
--- a/.github/workflows/validate.yml
+++ b/.github/workflows/validate.yml
@@ -14,7 +14,7 @@ jobs:
       - uses: actions/checkout@v4
       - uses: open-policy-agent/setup-opa@v2
         with:
-          version: latest
+          version: v1.4.2
       - name: opa test policies/
         run: opa test policies/ -v
 
@@ -82,6 +82,10 @@ jobs:
       - name: Warn when policy checks are skipped
         if: steps.plan.outcome != 'success'
         run: |
+          if [ -n "${{ vars.AWS_ROLE_ARN }}" ]; then
+            echo "::error::terraform plan failed even though AWS OIDC credentials (AWS_ROLE_ARN) are configured for this repo. This is a real failure, not a missing-credentials situation."
+            exit 1
+          fi
           echo "::warning::terraform plan could not be produced (no real AWS credentials configured for this repo)."
           echo "::warning::Policy checks (conftest) are skipped this run. Once the AWS_ROLE_ARN repository variable is configured for GitHub OIDC, terraform plan will succeed and policy enforcement will activate automatically."
 
diff --git a/policies/lib/util.rego b/policies/lib/util.rego
index ca8fdb6..12c0308 100644
--- a/policies/lib/util.rego
+++ b/policies/lib/util.rego
@@ -7,34 +7,51 @@ import rego.v1
 
 # All resources with a known "after" value (created or updated, not destroyed).
 known_changes contains rc if {
-  some rc in input.resource_changes
-  rc.change.after != null
+	some rc in input.resource_changes
+	rc.change.after != null
 }
 
 # Resources of a given type with a known after-state.
 resources_of_type(t) := [rc |
-  some rc in known_changes
-  rc.type == t
+	some rc in known_changes
+	rc.type == t
 ]
 
 # Value of an attribute on the first resource of type t; null if absent.
 first_attr(t, attr) := v if {
-  rs := resources_of_type(t)
-  count(rs) > 0
-  v := object.get(rs[0].change.after, attr, null)
+	rs := resources_of_type(t)
+	count(rs) > 0
+	v := object.get(rs[0].change.after, attr, null)
 } else := null if {
-  count(resources_of_type(t)) == 0
-  v := null
+	count(resources_of_type(t)) == 0
+	v := null
 }
 
 # True if at least one resource of type t exists in the plan.
 has_type(t) if count(resources_of_type(t)) > 0
 
+# True if the given attribute is unknown at plan time: its value in "after"
+# is null AND terraform flagged it as unknown in "after_unknown". Distinguish
+# this from a known missing/empty value (null/absent without the flag), which
+# should still be treated as a policy violation.
+is_unknown(attr, after, after_unknown) if {
+	object.get(after, attr, null) == null
+	object.get(after_unknown, attr, false) == true
+}
+
 # Helper for tests: construct a minimal plan input.
 mock_plan(resources) := {"resource_changes": resources}
 
 mock_resource(type_, name, after) := {
-  "type": type_,
-  "name": name,
-  "change": {"actions": ["create"], "after": after},
+	"type": type_,
+	"name": name,
+	"change": {"actions": ["create"], "after": after},
+}
+
+# Same as mock_resource, but also carries an after_unknown map so tests can
+# simulate plan-time unknown values (computed attributes not yet resolved).
+mock_resource_unknown(type_, name, after, after_unknown) := {
+	"type": type_,
+	"name": name,
+	"change": {"actions": ["create"], "after": after, "after_unknown": after_unknown},
 }
