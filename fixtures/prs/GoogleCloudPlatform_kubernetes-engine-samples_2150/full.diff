+    def _apply_pi05_attention_mask_patch():
+        """Tolerate pad/attention mask length mismatches. Same patch training uses."""
+        import lerobot.policies.pi05.modeling_pi05 as mp
+        if getattr(mp, "_PI05_MASK_PATCH_APPLIED", False):
