+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: physical-ai-mirror-sync
+  namespace: default
+  labels:
+    app.kubernetes.io/name: physical-ai-mirror-sync
+spec:
+  backoffLimit: 2
+  ttlSecondsAfterFinished: 600
+  template:
+    metadata:
+      annotations:
+        gke-gcsfuse/volumes: "true"
+        gke-gcsfuse/mount-options: "uid=1000,gid=1000"
+    spec:
+      restartPolicy: OnFailure
+      serviceAccountName: workload-identity-k8s-sa
+      securityContext:
+        fsGroup: 100
+      containers:
+        - name: mirror-sync
+          image: rayproject/ray:2.55.1-py311
+          command: ["/bin/bash", "-c"]
+          args:
+            - |
+              python3 /app/tools/sync_mirror_from_anyscale.py --dest-dir /checkpoint/physical-ai/mirror --workers 16
+          resources:
+            requests:
+              cpu: "4"
+              memory: "8Gi"
+            limits:
+              cpu: "8"
+              memory: "16Gi"
+          volumeMounts:
+            - name: checkpoint-storage
+              mountPath: /checkpoint
+            - name: tools-volume
+              mountPath: /app/tools
+      volumes:
+        - name: checkpoint-storage
+          persistentVolumeClaim:
+            claimName: physical-ai-checkpoint-pvc
+        - name: tools-volume
+          configMap:
+            name: physical-ai-tools
