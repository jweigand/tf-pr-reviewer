# Copy to .env and edit. Defaults here are the reviewer path: everything bundled,
# no GitHub token, no API key, no native installs.
#
#   cp .env.example .env && docker compose up

# ---------------------------------------------------------------- ingest
# replay = recorded Search API pages in fixtures/search/ (default, no token needed)
# live   = poll the GitHub Search API, needs GITHUB_TOKEN
INGEST_MODE=replay

# Only used when INGEST_MODE=live. Public repos are all this reads, so the token
# needs no scopes at all: an unscoped classic PAT, or a fine-grained token with
# "Public repositories, read-only". Unauthenticated works but caps at 60 req/hr.
GITHUB_TOKEN=

# ---------------------------------------------------------------- model
# Bundled Ollama in a container. CPU-only on macOS, so it works but it is slow.
COMPOSE_PROFILES=bundled-llm
OLLAMA_URL=http://ollama:11434

# Native Ollama on the host instead (much faster on a Mac, uses the GPU):
#   1. ollama serve && ollama pull qwen3.5:9b
#   2. comment out COMPOSE_PROFILES above
#   3. OLLAMA_URL=http://host.docker.internal:11434

MODEL=qwen3.5:9b

# ---------------------------------------------------------------- hosted model
# Swap the local model for Claude. Everything downstream is unchanged: the same JSON
# schema, the same verification, the same rubric.
#
#   MODEL_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Leave COMPOSE_PROFILES unset when you do, so the bundled Ollama does not start.
# The context budget also widens automatically, so far fewer pull requests are skipped
# as too_large than on the 8192-token local window.
MODEL_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
# The context budget on the hosted path. OLLAMA_NUM_CTX does not apply here.
ANTHROPIC_CONTEXT_LIMIT=200000
# low | medium | high | xhigh | max. Blank uses the model default.
ANTHROPIC_EFFORT=
# Routes a request refused by a safety classifier to another model instead of failing.
ANTHROPIC_FALLBACKS=true

# Never rely on Ollama's defaults. qwen3.5:9b ships with thinking on and
# presence_penalty 1.5, and both work against what this pipeline needs.
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3000
OLLAMA_TEMPERATURE=0
OLLAMA_PRESENCE_PENALTY=0
OLLAMA_KEEP_ALIVE=30m

# ---------------------------------------------------------------- storage
POSTGRES_USER=tfpr
POSTGRES_PASSWORD=tfpr
POSTGRES_DB=tfpr
POSTGRES_PORT=5432

# ---------------------------------------------------------------- ports
WEB_HOST_PORT=8080
# Redpanda Console, the topic browser. On by default; to run without it:
#   docker compose up --scale console=0
CONSOLE_HOST_PORT=8081
