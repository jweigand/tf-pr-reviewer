+        f"  - {_TIED_EMBED_KEY}",
+    )
+
+    _BENIGN_LEROBOT_LOG_PREFIXES = (
+        "Vision embedding key might need handling:",
+        *_BENIGN_LEROBOT_PRINTS,
+    )
