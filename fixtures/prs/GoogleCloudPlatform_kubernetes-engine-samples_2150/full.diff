+                "exit_code": proc.returncode,
+                "stdout_tail": "\n".join(proc.stdout.splitlines()[-20:]),
+                "stderr_tail": "\n".join(proc.stderr.splitlines()[-10:]) if proc.returncode else "",
+                "results": results,
