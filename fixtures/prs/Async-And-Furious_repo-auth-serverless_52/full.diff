+++ b/.github/workflows/auth-smoke.yml
@@ -0,0 +1,230 @@
+name: Auth deploy and smoke test
+
+on:
+  workflow_dispatch:
+    inputs:
+      environment:
+        description: Environment to deploy and test
+        required: true
+        type: choice
+        options: [hml, prod]
+      confirm:
+        description: Required only for production
+        required: false
+        default: ""
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  deploy:
+    uses: ./.github/workflows/ci.yml
+    with:
+      environment: ${{ inputs.environment }}
+      operation: apply
+      deploy_auth_only: false
+      confirm: ${{ inputs.confirm }}
+    secrets: inherit
+
+  request:
+    needs: deploy
+    runs-on: ubuntu-latest
+    environment: ${{ inputs.environment == 'prod' && 'production' || 'hml' }}
+    permissions:
+      contents: read
+    env:
+      AWS_REGION: ${{ vars.AWS_REGION || 'us-east-1' }}
+      SEEDED_CPF: ${{ secrets.SEEDED_CPF }}
+    steps:
+      - uses: actions/checkout@v4
+      - name: Configure AWS credentials
+        uses: aws-actions/configure-aws-credentials@v4
+        with:
+          aws-region: ${{ env.AWS_REGION }}
+          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
+          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+          aws-session-token: ${{ secrets.AWS_SESSION_TOKEN }}
+      - name: Discover deployed auth endpoint
+        shell: bash
+        env:
+          ENVIRONMENT: ${{ inputs.environment }}
+        run: |
+          set -euo pipefail
+          api_endpoint="$(aws apigatewayv2 get-apis \
+            --query "Items[?Name=='tc3-auth-${ENVIRONMENT}'].ApiEndpoint | [0]" \
+            --output text)"
+          test -n "$api_endpoint" && test "$api_endpoint" != "None"
+          printf 'API_ENDPOINT=%s\nAUTH_FUNCTION_NAME=tc3-auth-%s-auth\n' \
+            "$api_endpoint" "$ENVIRONMENT" >> "$GITHUB_ENV"
+      - name: Inspect bounded Lambda and database connectivity configuration
+        shell: bash
+        env:
+          ENVIRONMENT: ${{ inputs.environment }}
+        run: |
+          set -euo pipefail
+          config_file="$RUNNER_TEMP/lambda-config.json"
+          aws lambda get-function-configuration --function-name "$AUTH_FUNCTION_NAME" --output json > "$config_file"
+          python - "$config_file" <<'PY'
+          import json
+          import sys
+          config = json.load(open(sys.argv[1], encoding="utf-8"))
+          vpc = config.get("VpcConfig", {})
+          print(json.dumps({
+              "lambda_state": config.get("State"),
+              "last_update_status": config.get("LastUpdateStatus"),
+              "timeout_seconds": config.get("Timeout"),
+              "subnet_count": len(vpc.get("SubnetIds", [])),
+              "security_group_count": len(vpc.get("SecurityGroupIds", [])),
+              "database_secret_configured": bool(config.get("Environment", {}).get("Variables", {}).get("DATABASE_SECRET_ARN")),
+          }))
+          PY
+          secret_arn="$(python - "$config_file" <<'PY'
+          import json
+          import sys
+          print(json.load(open(sys.argv[1], encoding="utf-8")).get("Environment", {}).get("Variables", {}).get("DATABASE_SECRET_ARN", ""))
+          PY
+          )"
+          if [ -n "$secret_arn" ]; then
+            aws secretsmanager get-secret-value --secret-id "$secret_arn" --query SecretString --output text > "$RUNNER_TEMP/database-secret.json"
+            python - "$RUNNER_TEMP/database-secret.json" <<'PY'
+          import json
+          import sys
+          value = json.load(open(sys.argv[1], encoding="utf-8"))
+          print(json.dumps({"database_secret_keys": sorted(value) if isinstance(value, dict) else []}))
+          PY
+          fi
+          aws rds describe-db-instances --db-instance-identifier "tc3-db-${ENVIRONMENT}" \
+            --query 'DBInstances[0].{status:DBInstanceStatus,port:Endpoint.Port,public:PubliclyAccessible,sg_count:length(VpcSecurityGroups)}' \
+            --output json
+      - name: Require approved seeded CPF secret
+        shell: bash
+        run: |
+          set -euo pipefail
+          if [ -z "${SEEDED_CPF:-}" ]; then
+            echo '::error title=Missing smoke credential::Configure the SEEDED_CPF secret in both the hml and production GitHub Environments; do not commit or print the CPF.'
+            exit 1
+          fi
+      - name: Call seeded CPF and verify JWT without printing it
+        shell: bash
+        run: |
+          set -euo pipefail
+          response_file="$RUNNER_TEMP/auth-response.json"
+          set +e
+          http_status="$(curl --silent --show-error --max-time 20 \
+            -H 'content-type: application/json' \
+            -H "x-correlation-id: github-${GITHUB_RUN_ID}" \
+            -d "$(python -c 'import json,os; print(json.dumps({"cpf": os.environ["SEEDED_CPF"]}))')" \
+            --output "$response_file" --write-out '%{http_code}' "$API_ENDPOINT/auth")"
+          curl_exit=$?
+          set -e
+          token_present="$(python - "$response_file" <<'PY'
+          import json
+          import sys
+          try:
+              value = json.load(open(sys.argv[1], encoding="utf-8")).get("token", "")
+              valid = isinstance(value, str) and len(value.split(".")) == 3 and all(value.split("."))
+          except Exception:
+              valid = False
+          print(str(valid).lower())
+          PY
+          )"
+          echo "HTTP_STATUS=$http_status TOKEN_PRESENT=$token_present CURL_EXIT=$curl_exit"
+          if ! { test "$curl_exit" -eq 0 && test "$http_status" = "200" && test "$token_present" = "true"; }; then
+            exit 1
+          fi
+          echo 'Seeded CPF authentication returned a structurally valid JWT.'
+      - name: Direct Lambda bounded diagnostic
+        if: always()
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -n "$AUTH_FUNCTION_NAME" || exit 0
+          payload_file="$RUNNER_TEMP/auth-diagnostic-payload.json"
+          response_file="$RUNNER_TEMP/auth-diagnostic-response.json"
+          python - "$payload_file" <<'PY'
+          import json
+          import os
+          import sys
+          json.dump({
+              "version": "2.0",
+              "routeKey": "POST /auth",
+              "rawPath": "/auth",
+              "headers": {"content-type": "application/json", "x-correlation-id": "github-diagnostic"},
+              "requestContext": {"requestId": "github-diagnostic"},
+              "body": json.dumps({"cpf": os.environ["SEEDED_CPF"]}),
+          }, open(sys.argv[1], "w", encoding="utf-8"))
+          PY
+          aws lambda invoke --function-name "$AUTH_FUNCTION_NAME" \
+            --cli-binary-format raw-in-base64-out --payload "fileb://$payload_file" \
+            "$response_file" >/dev/null
+          python - "$response_file" <<'PY'
+          import json
+          import sys
+          try:
+              result = json.load(open(sys.argv[1], encoding="utf-8"))
+              body = json.loads(result.get("body", "{}")) if isinstance(result.get("body"), str) else result.get("body", {})
+              token = body.get("token", "") if isinstance(body, dict) else ""
+              token_present = isinstance(token, str) and len(token.split(".")) == 3 and all(token.split("."))
+              print(f"DIRECT_STATUS={result.get('statusCode', 'unknown')} DIRECT_TOKEN_PRESENT={str(token_present).lower()}")
+          except Exception:
+              print("DIRECT_STATUS=unparseable DIRECT_TOKEN_PRESENT=false")
+          PY
+      - name: Collect bounded sanitized CloudWatch diagnostics
+        if: always()
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -n "$AUTH_FUNCTION_NAME" || exit 0
+          start_ms="$(( $(date +%s) * 1000 - 900000 ))"
+          for attempt in 1 2 3 4 5 6; do
+            aws logs filter-log-events --log-group-name "/aws/lambda/$AUTH_FUNCTION_NAME" \
+              --start-time "$start_ms" --limit 50 --output json > "$RUNNER_TEMP/auth-logs.json" || true
+            python - "$RUNNER_TEMP/auth-logs.json" <<'PY' > "$RUNNER_TEMP/auth-errors.json"
+          import json
+          import re
+          import sys
+
+          def safe(value):
+              text = str(value or "")
+              text = re.sub(r"\b\d{3}[.\s-]?\d{3}[.\s-]?\d{3}[.\s-]?\d{2}\b", "[REDACTED_CPF]", text)
+              text = re.sub(r"\b[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b", "[REDACTED_JWT]", text)
+              text = re.sub(r"(?i)\b(password|secret|token|authorization|api[_-]?key)\s*[:=]\s*[^\s,;}]+", r"\1=[REDACTED]", text)
+              return text[:1000]
+
+          try:
+              rows = json.load(open(sys.argv[1], encoding="utf-8")).get("events", [])
+          except Exception:
+              rows = []
+          for row in rows:
+              message = row.get("message", "")
+              try:
+                  record = json.loads(message)
+              except Exception:
+                  record = {}
+              if record.get("level") == "error" or str(record.get("event", "")).endswith("_failed"):
+                  print(json.dumps({
+                      "timestamp": row.get("timestamp"),
+                      "log_stream": row.get("logStreamName"),
+                      "level": record.get("level"),
+                      "event": record.get("event"),
+                      "correlation_id": safe(record.get("correlation_id")),
+                      "error_name": safe(record.get("error_name")),
+                      "error_message": safe(record.get("error_message")),
+                      "duration_ms": record.get("duration_ms"),
+                  }))
+              elif not record and any(word in message.lower() for word in ("error", "exception", "timeout", "accessdenied")):
+                  print(json.dumps({
+                      "timestamp": row.get("timestamp"),
+                      "log_stream": row.get("logStreamName"),
+                      "level": "error",
+                      "event": "runtime_error",
+                      "error_message": safe(message),
+                  }))
+          PY
+            if test -s "$RUNNER_TEMP/auth-errors.json"; then
+              cat "$RUNNER_TEMP/auth-errors.json"
+              break
+            fi
+            test "$attempt" -eq 6 || sleep 5
+          done
