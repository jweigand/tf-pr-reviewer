    "gists_url": "https://api.github.com/users/kenoir/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/kenoir/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/kenoir/subscriptions",
    "organizations_url": "https://api.github.com/users/kenoir/orgs",
    "repos_url": "https://api.github.com/users/kenoir/repos",
    "events_url": "https://api.github.com/users/kenoir/events{/privacy}",
